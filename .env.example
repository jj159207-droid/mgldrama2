# Copy this file to .env.local and fill values on your own computer.
# For a new customer, prefer .env.client.example or run CLIENT-SETUP.cmd.
# Do NOT share real credentials or put service/admin/SMS secrets in NEXT_PUBLIC_*.

# Public branding. Safe to expose in the browser.
NEXT_PUBLIC_SITE_NAME=ТАЗА САЙТ
NEXT_PUBLIC_SITE_SHORT_NAME=ТАЗА
NEXT_PUBLIC_SITE_DESCRIPTION=Монгол, гадаад, хятад кино үзэх сайт.

# Set the exact browser origin (no path). Required on the HTTPS host.
SITE_URL=https://kino.example.com

# Each client must have its own Supabase project.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_SERVICE_ROLE_KEY
# Alternative name for a new sb_secret_... key.
SUPABASE_SECRET_KEY=

# Unique per client. 16+ characters.
ADMIN_PASSWORD=REPLACE_WITH_A_NEW_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS

# Default payment account. Admin can update these later in Settings.
BANK_NAME=Хаан банк
BANK_ACCOUNT=REPLACE_WITH_ACCOUNT_NUMBER
BANK_ACCOUNT_NAME=REPLACE_WITH_ACCOUNT_OWNER

# Optional public contact fallback.
MESSENGER_URL=

# Optional automatic SMS confirmation. Leave both empty for manual confirmation.
SMS_WEBHOOK_SECRET=
SMS_ALLOWED_SENDER=
