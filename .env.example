# Copy this file to .env.local and fill values on your own computer.
# Do NOT share real credentials or put service/admin/SMS secrets in NEXT_PUBLIC_*.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_SERVICE_ROLE_KEY
ADMIN_PASSWORD=REPLACE_WITH_A_NEW_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
# Optional; leave empty if using only manual admin payment confirmation.
SMS_WEBHOOK_SECRET=

# Optional exact sender name/number used by the trusted SMS forwarding phone.
SMS_ALLOWED_SENDER=
# Optional public contact fallback if legacy settings columns are missing.
MESSENGER_URL=

# Set the exact browser origin (no path). Required on the HTTPS host.
# For LAN development, use http://CURRENT-COMPUTER-IP:3000.
# When binding to 0.0.0.0, do not leave this empty for LAN browser requests.
SITE_URL=
# Alternative name for a new sb_secret_... key. Existing SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=
