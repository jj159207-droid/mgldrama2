# CLIENT COPY - use unique values for every customer.
# Copy to .env.local locally and set the same values in Vercel.
# Never reuse another customer's secrets.

NEXT_PUBLIC_SITE_NAME=ШИНЭ КИНО САЙТ
NEXT_PUBLIC_SITE_SHORT_NAME=КИНО
NEXT_PUBLIC_SITE_DESCRIPTION=Монгол, гадаад, хятад кино үзэх сайт.

SITE_URL=https://kino.example.com

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_THIS_CLIENT_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=

ADMIN_PASSWORD=REPLACE_WITH_THIS_CLIENT_ADMIN_PASSWORD

BANK_NAME=Хаан банк
BANK_ACCOUNT=REPLACE_WITH_CLIENT_ACCOUNT_NUMBER
BANK_ACCOUNT_NAME=REPLACE_WITH_CLIENT_ACCOUNT_OWNER

MESSENGER_URL=

# Optional automatic SMS confirmation.
# Leave both empty for manual payment confirmation.
SMS_WEBHOOK_SECRET=
SMS_ALLOWED_SENDER=
